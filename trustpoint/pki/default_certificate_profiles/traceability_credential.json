{
    "type": "cert_profile",
    "display_name": "Traceability Credential",
    "credential_type": "traceability_credential",
    "subj": {
        "allow": "*",
        "common_name": {
            "required": true,
            "mutable": true
        }
    },
    "reject_mods": false,
    "ext": {
        "basic_constraints": {
            "ca": false,
            "critical": true
        },
        "key_usage": {
            "digital_signature": true,
            "content_commitment": false,
            "key_encipherment": false,
            "data_encipherment": false,
            "key_agreement": false,
            "key_cert_sign": false,
            "crl_sign": false,
            "encipher_only": false,
            "decipher_only": false,
            "critical": true
        }
    },
    "validity": {
        "days": 365
    }
}
