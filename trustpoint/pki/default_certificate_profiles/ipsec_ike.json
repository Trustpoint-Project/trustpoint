{
    "type": "cert_profile",
    "display_name": "IPsec IKE",
    "credential_type": "application",
    "subj": {
        "allow": "*",
        "common_name": {"required": true},
        "organization_name": {"default": "{{ domain.organization }}"},
        "organizational_unit_name": {"default": "{{ domain.organization_unit }}"},
        "country_name": {"default": "{{ domain.country }}"},
        "state_or_province_name": {"default": "{{ domain.state }}"},
        "locality_name": {"default": "{{ domain.locality }}"}
    },
    "reject_mods": false,
    "ext": {
        "basic_constraints": {
            "ca": false,
            "critical": true
        },
        "key_usage": {
            "digital_signature": true,
            "critical": true
        },
        "extended_key_usage": {
            "usages": ["ipsec_ike"]
        },
        "subject_alternative_name": {
            "dns_names": {"required": true},
            "ip_addresses": {"required": false},
            "rfc822_names": {"required": false},
            "critical": false
        }
    },
    "validity": {
        "days": 365
    }
}