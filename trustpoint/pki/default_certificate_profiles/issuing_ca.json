{
    "type": "cert_profile",
    "display_name": "Issuing CA",
    "credential_type": "application",
    "subj": {
        "allow": "*",
        "common_name": {"required": true},
        "organization_name": {"required": true, "default": "{{ domain.organization }}"},
        "organizational_unit_name": {"default": "{{ domain.organization_unit }}"},
        "country_name": {"required": true, "default": "{{ domain.country }}"},
        "state_or_province_name": {"required": true, "default": "{{ domain.state }}"},
        "locality_name": {"default": "{{ domain.locality }}"}
    },
    "reject_mods": false,
    "ext": {
        "basic_constraints": {
            "ca": true,
            "path_length": 0
        },
        "key_usage": {
            "key_cert_sign": true,
            "crl_sign": true,
            "critical": true
        }
    },
    "validity": {
        "days": 3650
    }
}
