{
  "type": "cert_profile",
  "display_name": "Comprehensive Test Profile",
  "credential_type": "application",
  "subj": {
    "allow": "*",
    "cn": {
      "required": true
    },
    "o": {
      "default": "{{ domain.organization }}"
    },
    "ou": {
      "value": "{{ domain.organization_unit }}",
      "mutable": false
    },
    "c": {
      "required": true,
      "default": "{{ domain.country }}"
    },
    "st": {
      "default": "{{ domain.state }}",
      "mutable": true
    },
    "l": {
      "value": "{{ domain.locality }}",
      "mutable": false
    },
    "emailAddress": {
      "default": "test@example.com",
      "required": false
    }
  },
  "ext": {
    "crl_distribution_points": {
      "critical": false,
      "uris": {
        "value": [
          "http://{tls_certificate.ip_address.1}/crl/{issuing_ca.id}"
        ],
        "mutable": true
      }
    },
    "allow": "*",
    "subject_alternative_name": {
      "allow": "*",
      "dns_names": {
        "default": [
          "example.com",
          "www.example.com"
        ],
        "mutable": true
      },
      "ip_addresses": {
        "required": true
      },
      "rfc822_names": {
        "default": [
          "admin@example.com"
        ],
        "mutable": true
      },
      "uris": {
        "value": [
          "https://example.com"
        ],
        "mutable": false
      }
    }
  },
  "validity": {
    "allow": "*",
    "days": 30
  }
}