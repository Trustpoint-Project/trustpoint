{
    "type": "cert_profile",
    "display_name": "DevOwnerID Domain Credential",
    "credential_type": "domain",
    "subj": {
        "allow": "*",
        "common_name": {"value": "DevOwnerID Domain Credential", "mutable": true}
    },
    "reject_mods": false,
    "ext": {
        "crl_distribution_points": {
            "critical": false,
            "uris": {
                "value": [
                    "http://{tls_certificate.ip_address.1}/crl/{issuing_ca.id}"
                ],
                "mutable": true
            }
        },
        "basic_constraints": {
            "ca": false
        }
    },
    "validity": {
        "days": 30
    }
}
