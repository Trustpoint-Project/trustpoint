{
    "type": "cert_profile",
    "display_name": "DevOwnerID",
    "subj": {
        "allow": "*",
        "common_name": {"required": true}
    },
    "reject_mods": false,
    "ext": {
        "crl_distribution_points": {
            "critical": false,
            "uris": {
                "value": [
                    "http://{tls_certificate.ip_address.1}/crl/{issuing_ca.id}"
                ],
                "mutable": true
            }
        },
        "basic_constraints": {
            "ca": true,
            "critical": true
        },
        "subject_alternative_name": {
            "uris": {
                "required": true
            },
            "critical": true
        }
    },
    "validity": {
        "days": 3650
    }
}
