{
  "schema": "trustpoint.web-automation.v1",
  "name": "Siemens Scalance S615 HTTPS Certificate",
  "version": "1.0.0",
  "metadata": {
    "vendor": "Siemens",
    "device_family": "Scalance S615",
    "firmware_hint": "Adapt selectors before use",
    "description": "Uploads an HTTPS certificate as PKCS#12 container to Siemens Scalance S615. Sets the password and restarts the device to activate the certificate."
  },
  "certificate_profile": "tls_server",
  "key_generation": "trustpoint",
  "encoding": "PKCS12",
  "paths": {
    "login": "/",
    "https_cert_upload": "/system/load-save/http/https-cert",
    "https_cert_password": "/system/load-save/passwords/https-cert",
    "restart": "/system/restart"
  },
  "inputs": {
    "device_username": {
      "type": "secret",
      "source": "device_credentials",
      "required": true
    },
    "device_password": {
      "type": "secret",
      "source": "device_credentials",
      "required": true
    },
    "private_key_password": {
      "type": "secret",
      "source": "device_credentials",
      "required": true,
      "description": "Password for the PKCS#12 container and certificate activation"
    }
  },
  "operations": {
    "onboard": {
      "steps": [
        {
          "id": "open-login",
          "action": "goto",
          "path_ref": "login",
          "timeout_ms": 30000
        },
        {
          "id": "enter-username",
          "action": "fill",
          "selector": "#bigLoginName",
          "value": "{{ device_username }}",
          "sensitive": true
        },
        {
          "id": "enter-password",
          "action": "fill",
          "selector": "#bigPassword",
          "value": "{{ device_password }}",
          "sensitive": true
        },
        {
          "id": "submit-login",
          "action": "click",
          "selector": "#loginLink"
        },
        {
          "id": "wait-for-navigation-menu",
          "action": "wait_for",
          "selector": "#navigation_group1",
          "state": "visible",
          "timeout_ms": 30000
        },
        {
          "id": "expand-system-menu",
          "action": "click",
          "selector": "li.treeFolder[link='system.mwp'] > table label a",
          "timeout_ms": 10000
        },
        {
          "id": "wait-for-loadandsave-link",
          "action": "wait_for",
          "selector": "a[href='?newtab=loadandsave.mwp']",
          "state": "visible",
          "timeout_ms": 30000
        },
        {
          "id": "navigate-to-loadandsave",
          "action": "click",
          "selector": "a[href='?newtab=loadandsave.mwp']",
          "timeout_ms": 10000
        },
        {
          "id": "wait-for-loadandsave-content",
          "action": "wait_for_network_idle",
          "timeout_ms": 30000
        },
        {
          "id": "wait-for-passwords-link",
          "action": "wait_for",
          "selector": "#tab_area a[href='?newtab=loadandsave_pass.mwp']",
          "state": "visible",
          "timeout_ms": 10000
        },
        {
          "id": "navigate-to-passwords",
          "action": "click",
          "selector": "#tab_area a[href='?newtab=loadandsave_pass.mwp']",
          "timeout_ms": 10000
        },
        {
          "id": "wait-for-password-fields",
          "action": "wait_for",
          "selector": "input[type='password'].vs1",
          "state": "visible",
          "timeout_ms": 30000
        },
        {
          "id": "enter-certificate-password",
          "action": "fill",
          "selector": "input[type='password'].vs1:nth-of-type(1)",
          "value": "{{ private_key_password }}",
          "sensitive": true
        },
        {
          "id": "confirm-certificate-password",
          "action": "fill",
          "selector": "input[type='password'].vs1:nth-of-type(2)",
          "value": "{{ private_key_password }}",
          "sensitive": true
        },
        {
          "id": "submit-password",
          "action": "click",
          "selector": "#btnWrite",
          "timeout_ms": 30000
        },
        {
          "id": "wait-for-password-saved",
          "action": "wait_for_network_idle",
          "timeout_ms": 30000
        },
        {
          "id": "navigate-back-to-http",
          "action": "click",
          "selector": "a[href='?newtab=loadandsave.mwp']",
          "timeout_ms": 10000
        },
        {
          "id": "wait-for-https-cert-upload-field",
          "action": "wait_for",
          "selector": "#EvWbmLoadSaveHttpLoadButton_9_48_54_54_50_53_43_65_72_74_file",
          "state": "attached",
          "timeout_ms": 30000
        },
        {
          "id": "upload-pkcs12-certificate",
          "action": "upload",
          "selector": "#EvWbmLoadSaveHttpLoadButton_9_48_54_54_50_53_43_65_72_74_file",
          "artifact": "{{ pkcs12_p12 }}"
        },
        {
          "id": "wait-for-restart-confirmation",
          "action": "wait_for",
          "selector": "#divMsgBox",
          "state": "visible",
          "timeout_ms": 30000
        },
        {
          "id": "confirm-restart",
          "action": "reboot_device",
          "selector": "#btnOk",
          "timeout_ms": 10000
        }
      ]
    },
    "renew": {
      "steps": [
        {
          "id": "open-login",
          "action": "goto",
          "path_ref": "login",
          "timeout_ms": 30000
        },
        {
          "id": "enter-username",
          "action": "fill",
          "selector": "#bigLoginName",
          "value": "{{ device_username }}",
          "sensitive": true
        },
        {
          "id": "enter-password",
          "action": "fill",
          "selector": "#bigPassword",
          "value": "{{ device_password }}",
          "sensitive": true
        },
        {
          "id": "submit-login",
          "action": "click",
          "selector": "#loginLink"
        },
        {
          "id": "wait-for-navigation-menu",
          "action": "wait_for",
          "selector": "#navigation_group1",
          "state": "visible",
          "timeout_ms": 30000
        },
        {
          "id": "expand-system-menu",
          "action": "click",
          "selector": "li.treeFolder[link='system.mwp'] > table label a",
          "timeout_ms": 10000
        },
        {
          "id": "wait-for-loadandsave-link",
          "action": "wait_for",
          "selector": "a[href='?newtab=loadandsave.mwp']",
          "state": "visible",
          "timeout_ms": 30000
        },
        {
          "id": "navigate-to-loadandsave",
          "action": "click",
          "selector": "a[href='?newtab=loadandsave.mwp']",
          "timeout_ms": 10000
        },
        {
          "id": "wait-for-https-cert-upload-field",
          "action": "wait_for",
          "selector": "#EvWbmLoadSaveHttpLoadButton_9_48_54_54_50_53_43_65_72_74_file",
          "state": "attached",
          "timeout_ms": 30000
        },
        {
          "id": "upload-pkcs12-certificate",
          "action": "upload",
          "selector": "#EvWbmLoadSaveHttpLoadButton_9_48_54_54_50_53_43_65_72_74_file",
          "artifact": "{{ pkcs12_p12 }}"
        },
        {
          "id": "wait-for-save-button-enabled",
          "action": "wait_for",
          "selector": "#gridWbmLoadSaveHttpd9_48_54_54_50_53_43_65_72_74 input.dl[value='Save']:not([disabled])",
          "state": "visible",
          "timeout_ms": 30000
        },
        {
          "id": "submit-upload",
          "action": "click",
          "selector": "#gridWbmLoadSaveHttpd9_48_54_54_50_53_43_65_72_74 input.dl[value='Save']",
          "timeout_ms": 30000
        },
        {
          "id": "wait-for-upload-modal",
          "action": "wait_for",
          "selector": "#divMsgBox",
          "state": "visible",
          "timeout_ms": 30000
        },
        {
          "id": "close-upload-modal",
          "action": "click",
          "selector": "#btnOk",
          "timeout_ms": 10000
        },
        {
          "id": "navigate-to-restart",
          "action": "click",
          "selector": "a[href='?newtab=restart.mwp']",
          "timeout_ms": 10000
        },
        {
          "id": "wait-for-restart-page",
          "action": "wait_for",
          "selector": "button:has-text('Restart')",
          "state": "visible",
          "timeout_ms": 30000
        },
        {
          "id": "restart-device",
          "action": "reboot_device",
          "selector": "button:has-text('Restart System')",
          "timeout_ms": 30000
        }
      ]
    }
  }
}
